import os
from pathlib import Path
import runpy
location = Path(__file__).resolve()
module = location.with_name('server.py')
if not module.is_file():
    prefix = location.parent.parent
    os.environ['TILEM_INSTALL_PREFIX'] = str(prefix)
    module = prefix / 'share' / 'tilem-portable' / 'server' / 'server.py'
runpy.run_path(str(module), run_name='__main__')
