# SPDX-License-Identifier: GPL-3.0-or-later
# Replace @OWNER@, @REPOSITORY@, and @SHA256@ after publishing a source release.
class TilemPortable < Formula
  desc "TI graphing calculator emulator with native GUI and local control"
  homepage "https://github.com/@OWNER@/@REPOSITORY@"
  url "https://github.com/@OWNER@/@REPOSITORY@/releases/download/v2.0.3/tilem-portable-2.0.3.tar.gz"
  sha256 "@SHA256@"
  # License metadata for inherited GFDL skin assets must be completed before release.
  license all_of: ["GPL-3.0-or-later", "LGPL-2.1-or-later"]

  depends_on "cmake" => :build
  depends_on "pkgconf" => :build
  depends_on "gtk+"
  depends_on "tilibs"
  depends_on "python@3.13"

  def install
    system "cmake", "-S", ".", "-B", "build", "-DBUILD_TESTING=OFF", *std_cmake_args
    system "cmake", "--build", "build"
    system "cmake", "--install", "build"
    # Use Homebrew's selected Python rather than whichever python3 is on PATH.
    inreplace bin/"tilem-server", "#!/usr/bin/env python3", "#!#{Formula["python@3.13"].opt_bin}/python3.13"
    doc.install "README.md", "docs"
  end
end
