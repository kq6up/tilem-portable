# $NetBSD$
# SPDX-License-Identifier: GPL-3.0-or-later
# Candidate only. Fill @OWNER@/@REPOSITORY@, generate distinfo and PLIST.
DISTNAME=       tilem-portable-2.0.1
CATEGORIES=     emulators
MASTER_SITES=   https://github.com/@OWNER@/@REPOSITORY@/releases/download/v2.0.1/

MAINTAINER=     pkgsrc-users@NetBSD.org
HOMEPAGE=       https://github.com/@OWNER@/@REPOSITORY@/
COMMENT=        TI calculator emulator with native GTK GUI and local control
# The inherited skin README does not identify an exact GFDL version.
# Resolve asset provenance before finalizing LICENSE for submission.
LICENSE=        gnu-gpl-v3 AND gnu-lgpl-v2.1

USE_CMAKE=      yes
USE_LANGUAGES=  c99
USE_TOOLS+=     pkg-config
CMAKE_CONFIGURE_ARGS+= -DTILEM_BUILD_GTK=ON -DBUILD_TESTING=OFF
REPLACE_PYTHON+= server/tilem-server server/server.py
PYTHON_VERSIONS_INCOMPATIBLE= 27

.include "../../lang/python/application.mk"
.include "../../x11/gtk2/buildlink3.mk"
.include "../../comms/libticonv/buildlink3.mk"
.include "../../comms/libtifiles2/buildlink3.mk"
.include "../../comms/libticables2/buildlink3.mk"
.include "../../comms/libticalcs2/buildlink3.mk"
.include "../../mk/bsd.pkg.mk"
